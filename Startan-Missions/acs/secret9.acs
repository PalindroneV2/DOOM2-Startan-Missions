script "GameStart" ENTER
{
    counter = 35 * 5;
    while(counter > 0)
    {
        Delay(1);
        counter--;
        HudMessageBold(s:"FETCH ME THEIR SOULS!";  HUDMSG_FADEOUT, 1003, CR_RED, 0.5, 0.5,1.0, 1);
        HudMessage(i:counter / 35;  HUDMSG_FADEOUT, 1004, CR_WHITE, 0.5, 0.55, 1.0, 1);
    }
    roundwave = 1;
    zombiesAllSpawned = false;
}

script "RoundWaveHandler" ENTER
{
    HudMessageBold(s:"Round: ", i:roundwave;  HUDMSG_PLAIN, 1002, CR_WHITE, 0.1, 0.1, 0, 1);
    // if ((roundwave % 5) == 0 && zombieCurrentCount == 0)
    // {
    //     Thing_Remove(115);
    //     // if(roundwave >=5){
    //     //     SpawnSpotFacing("TeleportFog", 101);
    //     //     SpawnSpotFacing("MaxAmmo_Powerup", 101);
    //     // }
    // }
    if (roundwave > 0)
    {
        zombieIntendedCount = 24 + ((roundwave - 1) * 4);
    }
    if (roundwave > 0 && zombiesAllSpawned == false)
    {
        // for (int mf = 0; mf < zombieIntendedCount; mf++)
        // int mf = 0;
        while(zombieCurrentCount < zombieIntendedCount)
        {
            ZombieSpawn();
            zombieCurrentCount = ThingCountName("W3DSSZombie",0) + ThingCountName("W3DHeerZombie",0);
            // Log(s:"MF",i:mf);
            // mf++
            Delay(15);
            if (zombieCurrentCount == zombieIntendedCount)
            {
                zombiesAllSpawned = true;
            }
        }
        zombieCurrentCount = ThingCountName("W3DSSZombie",0) + ThingCountName("W3DHeerZombie",0);
        zombiesAllSpawned = true;
        // once all zombies have spawned, set to true
    }
    if (zombieCurrentCount == 0 && zombiesAllSpawned == true && roundwave > 0)
    {
        counter = 350;
        while(counter > 0)
        {
            Delay(1);
            counter--;
            HudMessageBold(s:"NEXT ROUND:";  HUDMSG_FADEOUT, 1003, CR_RED, 0.5, 0.5,1.0, 1);
            HudMessage(i:counter / 35;  HUDMSG_FADEOUT, 1004, CR_WHITE, 0.5, 0.55, 1.0, 1);
        }
        roundwave++;
        zombiesAllSpawned = false;
    }
    Delay(35);
    Restart;
}

script "HatePlayerNow" (void)
{
    int FakeHaterActivator = ActivatorTID();
    Thing_ChangeTID(FakeHaterActivator, 115);
    Thing_Hate(115, 900, 2);
}

script "GiveFullAmmo" (void)
{
    SpawnSpotFacing("TeleportFog", 100);
    SpawnSpotFacing("MaxAmmo_Powerup", 100);
}

function void ZombieSpawn (void)
{
    str zombies[2] = {"W3DSSZombie", "W3DHeerZombie"};
    int zombiechoice = Random(0,1);
    int spawnchoice = Random (1,96);
    int zombieSpawnID;
    // Log(s:"Spot: ", i:spawnchoice, s: " -- Spawnnumber: ", i:wavenumbers );
    if (spawnchoice >= 49 && spawnchoice <= 60)
    {
        FakeHater = 500 + spawnchoice;
        ZombieSpawnID = FakeHater;
        SpawnSpotFacing(zombies[zombiechoice], spawnchoice, FakeHater);
        SpawnSpotFacing("TeleportFog", spawnchoice, 0);
        SetThingSpecial(FakeHater, ACS_NamedExecuteAlways, "ZombieKill1");
        Thing_Hate(FakeHater, 600, 2);
        SetActorFlag(FakeHater, "COUNTKILL", false);
        // ZombieHealthHandle();
        SetActorProperty(ZombieSpawnID, APROP_Health, ZombieHealthHandle());
        // Log(s:"FakeHater ID: ", i:FakeHater);
    }else{
        ZombieSpawnID = 115;
        SpawnSpotFacing(zombies[zombiechoice], spawnchoice, ZombieSpawnID);
        // Log(s:"Spawning Zombie Type: ", s:zombies[zombiechoice]);
        SpawnSpotFacing("TeleportFog", spawnchoice, 0);
        SetThingSpecial(ZombieSpawnID, ACS_NamedExecuteAlways, "ZombieKill1");
        SetActorFlag(ZombieSpawnID, "COUNTKILL", false);
        Thing_Hate(ZombieSpawnID, 900, 2);
        // ZombieHealthHandle();
        SetActorProperty(ZombieSpawnID, APROP_Health, ZombieHealthHandle());
    }
}

function int ZombieHealthHandle(void)
{
    int ZombieSpawnID = 115;
    if (roundwave <= 9)
    {
        zombieNewHealth = zombieStartHealth + ((roundwave - 1) * 10);
    }
    if (roundwave >= 10)
    {
        zombieNewHealth = zombieNewHealth * 1.05;
    }
    // Log(s:"ZHP: ", i:zombieNewHealth);
    return zombieNewHealth;
}

script "zombieCurrentCount" ENTER
{
    zombieCurrentCount = ThingCountName("W3DSSZombie",0) + ThingCountName("W3DHeerZombie",0);
    // HudMessageBold(s:"Zombies Remaining: ", i:zombieCurrentCount;  HUDMSG_PLAIN, 1000, CR_WHITE, 0.5, 0.125, 0, 1); //Counter with no intended full count
    HudMessageBold(s:"Zombies Remaining: ", i:zombieCurrentCount, s:"/", i:zombieIntendedCount;  HUDMSG_PLAIN, 1000, CR_WHITE, 0.5, 0.125, 0, 1); //counter with intended full count;
    Delay(1);
    Restart;
}

