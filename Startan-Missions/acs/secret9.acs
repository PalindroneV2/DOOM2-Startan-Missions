script "GameStart" ENTER
{
    counter = 35 * 5;
    while(counter > 0)
    {
        Delay(1);
        counter--;
        HudMessageBold(s:"FETCH ME THEIR SOULS!";  HUDMSG_FADEOUT, 1003, CR_RED, 0.5, 0.5,1.0, 1);
        HudMessage(i:counter / 35;  HUDMSG_FADEOUT, 1004, CR_WHITE, 0.5, 0.55, 1.0, 1);
    }
    roundwave = 1;
    roundcomplete = false;
}

script "RoundWaveHandler" ENTER
{
    HudMessageBold(s:"Round: ", i:roundwave;  HUDMSG_PLAIN, 1002, CR_WHITE, 0.1, 0.1, 0, 1);
    if (roundwave > 0)
    {
        howmanyzombies = 24 + ((roundwave - 1) * 4);
    }
    if ((roundwave % 5) == 0 && zombiecount == 0)
    {
        Thing_Remove(115);
        if(roundwave >=5){
            SpawnSpotFacing("TeleportFog", 101);
            SpawnSpotFacing("MaxAmmo_Powerup", 101);
        }
    }
    zombiecount = ThingCount(T_NONE, 115);
    if (roundwave > 0 && roundcomplete == false && wavenumbers < 1)
    {
        while(wavenumbers < howmanyzombies && zombiecount < howmanyzombies)
        {
            ZombieSpawn();
            wavenumbers++;
            zombiecount = ThingCount(T_NONE, 115);
            Delay(10);
        }
    }
    zombiecount = ThingCount(T_NONE, 115) + ThingCount(T_NONE, FakeHater);
    if (wavenumbers >= howmanyzombies)
    {
        roundcomplete = true;
    }
    wavenumbers = 0;
    if (zombiecount == 0 && roundcomplete == true && roundwave > 0)
    {
        counter = 350;
        while(counter > 0)
        {
            Delay(1);
            counter--;
            HudMessageBold(s:"NEXT ROUND:";  HUDMSG_FADEOUT, 1003, CR_RED, 0.5, 0.5,1.0, 1);
            HudMessage(i:counter / 35;  HUDMSG_FADEOUT, 1004, CR_WHITE, 0.5, 0.55, 1.0, 1);
        }
        roundwave++;
        roundcomplete = false;
    }
    Delay(35);
    Restart;
}

script "HatePlayerNow" (void)
{
    int FakeHaterActivator = ActivatorTID();
    Thing_ChangeTID(FakeHaterActivator, 115);
    Thing_Hate(115, 900, 2);
}

script "GiveFullAmmo" (void)
{
    SpawnSpotFacing("TeleportFog", 100);
    SpawnSpotFacing("MaxAmmo_Powerup", 100);
}

function void ZombieSpawn (void)
{
    str zombies[2] = {"W3DSSZombie", "W3DHeerZombie"};
    int zombiechoice = Random(0,1);
    int spawnchoice = Random (1,96);
    // Log(s:"Spot: ", i:spawnchoice, s: " -- Spawnnumber: ", i:wavenumbers );
    if (spawnchoice >= 49 && spawnchoice <= 60)
    {
        FakeHater = 500 + spawnchoice;
        SpawnSpotFacing(zombies[zombiechoice], spawnchoice, FakeHater);
        SpawnSpotFacing("TeleportFog", spawnchoice, 0);
        SetThingSpecial(FakeHater, ACS_NamedExecuteAlways, "ZombieKill1");
        Thing_Hate(FakeHater, 600, 2);
        SetActorFlag(FakeHater, "COUNTKILL", false);
        // Log(s:"FakeHater ID: ", i:FakeHater);
    }else{
        SpawnSpotFacing(zombies[zombiechoice], spawnchoice, 115);
        // Log(s:"Spawning Zombie Type: ", s:zombies[zombiechoice]);
        SpawnSpotFacing("TeleportFog", spawnchoice, 0);
        SetThingSpecial(115, ACS_NamedExecuteAlways, "ZombieKill1");
        SetActorFlag(115, "COUNTKILL", false);
        Thing_Hate(115, 900, 2);
    }
}

script "ZombieCount" ENTER
{
    zombiecount = ThingCount(T_NONE, 115);
    HudMessageBold(s:"Zombies Remaining: ", i:zombiecount;  HUDMSG_PLAIN, 1000, CR_WHITE, 0.5, 0.125, 0, 1);
    // HudMessageBold(i:zombiecount, s:"/", i:howmanyzombies;  HUDMSG_PLAIN, 1001, CR_WHITE, 0.5, 0.15, 0, 1);
    Delay(1);
    Restart;
}

script "PlayerRegen" ENTER
{
    playershealth = GetActorProperty(900, APROP_Health);
    if (playershealth < 100){
        Delay (3*35);
        while (playershealth < 100){
            playershealth = GetActorProperty(900, APROP_Health);
            GiveActorInventory(900, "Medikit", 10);
            Delay(10);
        }
    }
    Delay(1);
    Restart;
}

script "Endmap" (void)
{
	SecretLevel39++;
	Teleport_NewMap(100,0, 0);
}

// Weapon tracking strings
str currentweapon;      // The weapon currently in hand
str lastweapon;         // The previous weapon (used for the "anti-duplicate" check)
str lastweapon2;        // The second previous weapon
str newweapon;          // The weapon currently being rolled by the box
str anothermiddleman;   // A safety variable for the randomizer loop

// Technical Actor names for spawning
str weaponbox[11] = {
    "M1911A1", "MP40", "Minigun", "M16", "Trenchgun", 
    "NewSuperShotgun", "NewRocketLauncher", "FastPlasmaRifle", 
    "BFG9000", "RayGun", "KAR98K"
};

// Friendly names for HUD messages
str weaponboxnames[11] = {
    "Walther PPK", "MP40", "Minigun", "M16A1", "Trenchgun", 
    "Super Shotgun", "Rocket Launcher", "Plasma Rifle", 
    "BFG9000", "Ray Gun", "Kar98K"
};

script "MysteryBox" (void) {
    int randy;
    currentweapon = GetWeapon();
    
    if(zombiepoints >= 950)
    {
        // Visual cycling effect
        for (int el = 0; el <= 10; el++)
        {
            SpawnSpotFacing(weaponbox[el], 950, 654);
            Delay(5);
            Thing_Remove(654);
        }

        // Logic to ensure you don't get the same weapon you are currently holding
        while ((StrCmp(newweapon, lastweapon) == 0) || (StrCmp(newweapon, currentweapon) == 0) || (StrCmp(newweapon, anothermiddleman) == 0))
        {
            randy = Random(0, 10);
            newweapon = weaponbox[randy];
        }

        zombiepoints = zombiepoints - 950;
        
        // Spawn the final chosen weapon
        SpawnSpotFacing(newweapon, 951, 655);
        SetThingSpecial(655, ACS_NamedExecute, "MysteryBoxGunSwitch");

        // Update weapon history
        lastweapon2 = lastweapon;
        lastweapon = currentweapon;
        currentweapon = newweapon;
        anothermiddleman = newweapon;

        Delay(20);

        // Give corresponding ammo based on the weapon index (randy)
        if(randy <= 3) {
            GiveActorInventory(900, "Clip", 400);
        } else if(randy == 4 || randy == 5) {
            GiveActorInventory(900, "Shell", 100);
        } else if (randy == 6) {
            GiveActorInventory(900, "RocketAmmo", 100);
        } else if(randy > 6 && randy < 10) {
            GiveActorInventory(900, "Cell", 300);
        } else if (randy == 10) {
            GiveActorInventory(900, "RifleBullets", 50);
        }

        Delay(105); // Time the weapon stays available to pick up
        Thing_Remove(655);
    } else {
        HudMessageBold(s:"Not Enough Points."; HUDMSG_FADEOUT, 900, CR_WHITE, 0.5, 0.7, 1.0, 1);
        Delay(35);
    }
}

script "MysteryBoxGunSwitch" (void)
{
    str fuckthisgun;
    int randy;

    // Special logic if the player is holding the "DoomFist"
    if(StrCmp(GetWeapon(), "DoomFist") == 0) {
        while (randy < 11)
        {
            randy = Random(0, 10);
            fuckthisgun = weaponbox[randy];
            Delay(1);
            if (CheckInventory(fuckthisgun) > 0)
            {
                TakeInventory(fuckthisgun, 1);
                Break;
            }
        }
    } 
    // If the player is picking up the same weapon they currently have
    else if(StrCmp(GetWeapon(), newweapon) == 0) {
        TakeInventory(GetWeapon(), 1);
        GiveInventory(newweapon, 1);
    } 
    // Standard exchange
    else {
        TakeInventory(GetWeapon(), 1);
    }
}

script "MysteryBoxTexto" (void)
{
    HudMessageBold(s:"Mystery Box: $950"; HUDMSG_FADEOUT, 900, CR_WHITE, 0.5, 0.7, 1.0, 1);
    Delay(35 * 5);
}

