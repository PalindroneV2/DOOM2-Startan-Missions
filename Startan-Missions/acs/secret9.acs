global int 9 : SecretLevel39;
int playershealth;
int playerisarmored;

int howmanyzombies;
int roundwave;
int zombiecount;
int wavenumbers;

int FakeHater;

int counter;

bool roundcomplete = false;

script 1 enter
{
	ClearInventory();
