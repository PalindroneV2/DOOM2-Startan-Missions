    HudMessageBold(s:"Zombies Remaining: ", i:zombieCurrentCount, s:"/", i:zombieIntendedCount;  HUDMSG_PLAIN, 1000, CR_WHITE, 0.5, 0.125, 0, 1); //counter with intended full count;
