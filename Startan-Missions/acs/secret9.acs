// Weapon tracking strings
str currentweapon;      // The weapon currently in hand
str lastweapon;         // The previous weapon (used for the "anti-duplicate" check)
str lastweapon2;        // The second previous weapon
str newweapon;          // The weapon currently being rolled by the box
str anothermiddleman;   // A safety variable for the randomizer loop

// Technical Actor names for spawning
str weaponbox[12] = {
    "M1911A1", "MP40", "Minigun", "M16", "Trenchgun", 
    "NewSuperShotgun", "NewRocketLauncher", "FastPlasmaRifle", 
    "BFG9000", "RayGun", "KAR98K", "Wunderwaffe"
};

// Friendly names for HUD messages
str weaponboxnames[12] = {
    "Walther PPK", "MP40", "Minigun", "M16A1", "Trenchgun", 
    "Super Shotgun", "Rocket Launcher", "Plasma Rifle", 
    "BFG9000", "Ray Gun", "Kar98K", "Wunderwaffe"
};

script "MysteryBox" (void) {
    int randy;
    currentweapon = GetWeapon();
    
    if(zombiepoints >= 950)
    {
        // Visual cycling effect
        for (int el = 0; el <= 11; el++)
        {
            SpawnSpotFacingForced(weaponbox[el], 1950, 1654);
            Delay(5);
            Thing_Remove(1654);
        }

        // Logic to ensure you don't get the same weapon you are currently holding
        while ((StrCmp(newweapon, lastweapon) == 0) || (StrCmp(newweapon, currentweapon) == 0) || (StrCmp(newweapon, anothermiddleman) == 0))
        {
            randy = Random(0, 10);
            newweapon = weaponbox[randy];
        }

        zombiepoints = zombiepoints - 950;
        
        // Spawn the final chosen weapon
        SpawnSpotFacingForced(newweapon, 1951, 1655);
        SetThingSpecial(1655, ACS_NamedExecute, "MysteryBoxGunSwitch");

        // Update weapon history
        lastweapon2 = lastweapon;
        lastweapon = currentweapon;
        currentweapon = newweapon;
        anothermiddleman = newweapon;

        Delay(20);

        // Give corresponding ammo based on the weapon index (randy)
        if(randy <= 3) {
            GiveActorInventory(900, "Clip", 400);
        } else if(randy == 4 || randy == 5) {
            GiveActorInventory(900, "Shell", 100);
        } else if (randy == 6) {
            GiveActorInventory(900, "RocketAmmo", 100);
        } else if(randy > 6 && randy < 10) {
            GiveActorInventory(900, "Cell", 300);
        } else if (randy == 10) {
            GiveActorInventory(900, "RifleBullets", 50);
        }

        Delay(105); // Time the weapon stays available to pick up
        Thing_Remove(1655);
    } else {
        HudMessageBold(s:"Not Enough Points."; HUDMSG_FADEOUT, 900, CR_WHITE, 0.5, 0.7, 1.0, 1);
        Delay(35);
    }
}

script "MysteryBoxGunSwitch" (void)
{
    str fuckthisgun;
    int randy;

    // Special logic if the player is holding the "DoomFist"
    if(StrCmp(GetWeapon(), "DoomFist") == 0) {
        while (randy < 12)
        {
            randy = Random(0, 11);
            fuckthisgun = weaponbox[randy];
            Delay(1);
            if (CheckInventory(fuckthisgun) > 0)
            {
                TakeInventory(fuckthisgun, 1);
                Break;
            }
        }
    } 
    // If the player is picking up the same weapon they currently have
    else if(StrCmp(GetWeapon(), newweapon) == 0) {
        TakeInventory(GetWeapon(), 1);
        GiveInventory(newweapon, 1);
    } 
    // Standard exchange
    else {
        TakeInventory(GetWeapon(), 1);
    }
}

script "MysteryBoxTexto" (void)
{
    HudMessageBold(s:"Mystery Box: $950"; HUDMSG_FADEOUT, 900, CR_WHITE, 0.5, 0.7, 1.0, 1);
    Delay(35 * 5);
}

